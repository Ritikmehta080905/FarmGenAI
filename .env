# ===================================================================
# AgriNegotiator System Environment Configuration (.env)
# ===================================================================

# ── APPLICATION ──
APP_NAME=AgriNegotiator
APP_ENV=development
DEBUG=True

# ── SECURITY & JWT ──
JWT_SECRET_KEY=supersecretkeyforagrinegotiatorsigningtokens12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LOCAL LLM (Ollama - Primary Engine) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── CLOUD LLM (Gemini - Backup Engine) ──
ENABLE_LLM=true
GEMINI_API_KEY=your_gemini_api_key_here

# ── DATABASE (PostgreSQL / Async SQLAlchemy) ──
DATABASE_URL=postgresql+asyncpg://admin:admin_password@localhost:5432/agrinegotiator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrinegotiator
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password

# ── REDIS & REDIS STREAMS ──
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CHROMADB VECTOR DATABASE ──
CHROMA_URL=http://localhost:8001
CHROMA_DB_PATH=./node_storage/chroma_db

# ── EMBEDDING MODEL ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── EXTERNAL PUBLIC SERVICES (NO API KEY REQUIRED) ──
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OSRM_BASE_URL=https://router.project-osrm.org

# ── OBJECT STORAGE (MinIO) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin