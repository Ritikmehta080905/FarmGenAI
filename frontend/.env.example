# AgriNegotiator Frontend — Environment Variables Example
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env to git.

# Backend API Base URL (FastAPI)
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket URL (FastAPI WebSocket endpoint)
VITE_WS_URL=ws://localhost:8000/ws

# Optional: App title override
# VITE_APP_TITLE=AgriNegotiator
